{
  "name": "@karamem0/commistant",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "start": "tsc && vite",
    "build": "tsc -b && vite build",
    "eslint": "eslint src",
    "eslint:fix": "eslint src --fix",
    "stylelint": "stylelint 'src/**/*.{css,scss,jsx,tsx}'",
    "stylelint:fix": "stylelint 'src/**/*.{css,scss,jsx,tsx}' --fix",
    "formatjs:extract": "formatjs extract src/**/messages.ts --out-file src/translations/ja.json --id-interpolation-pattern [sha512:contenthash:base64:6] --format simple",
    "formatjs:compile": "formatjs compile src/translations/ja.json --out-file src/translations/compiled/ja.json --ast --format simple"
  },
  "dependencies": {
    "@automapper/pojos": "^9.0.2",
    "@emotion/react": "^11.14.0",
    "@fluentui/react-components": "^9.74.11",
    "@microsoft/applicationinsights-react-js": "^19.4.2",
    "@microsoft/applicationinsights-web": "^3.4.5",
    "@microsoft/teams-js": "2.58.0",
    "axios": "^1.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "react-intl": "^12.1.5",
    "react-router": "^8.5.0",
    "react-use": "^17.6.1",
    "ress": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@formatjs/cli": "^6.16.35",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-formatjs": "^13.0.8",
    "eslint": "^9.39.5",
    "eslint-plugin-hooks": "^0.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "postcss-styled-syntax": "^0.7.4",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
